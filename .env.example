# Copy this file to .env and fill in the credentials for your approved
# OpenAI-compatible LLM service. Do not commit .env.

# Required for local JD preparation and resume scoring.
OPENAI_BASE_URL=https://your-llm-provider.example
OPENAI_API_KEY=replace-with-your-api-key

# Optional. Defaults to gpt-5.4-mini when omitted.
OPENAI_MODEL=gpt-5.4-mini

# Optional. Integer from 1 through 8; defaults to 4 when omitted.
BOSS_HIRE_LLM_WORKERS=4
